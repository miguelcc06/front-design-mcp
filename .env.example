# front-design-mcp environment template
#
# NEVER commit a real .env file. Copy this to `.env` locally and fill values.
# All settings use the FRONT_DESIGN_ prefix (see src/front_design_mcp/config.py).

# =============================================================================
# Core
# =============================================================================

# Root for fixtures, cache, and store artifacts. Default: ./data (cwd-relative)
# FRONT_DESIGN_DATA_DIR=

# SQLite path. Default: $FRONT_DESIGN_DATA_DIR/store/front_design.db
# FRONT_DESIGN_DB_PATH=

# DEBUG | INFO | WARNING | ERROR
FRONT_DESIGN_LOG_LEVEL=INFO

# HTTP timeout (seconds) for network ingest adapters
FRONT_DESIGN_HTTP_TIMEOUT=30

# Network ingest is OFF by default (offline fixtures). Set true only intentionally.
FRONT_DESIGN_ENABLE_NETWORK_INGEST=false

# =============================================================================
# Storage backend
# =============================================================================

# sqlite (default, offline BM25 only — NO vector/hybrid search)
# postgres (opt-in; requires uv sync --extra postgres + migrations)
FRONT_DESIGN_STORE_BACKEND=sqlite

# Required when STORE_BACKEND=postgres. +psycopg dialect suffix is OK (stripped at runtime).
# FRONT_DESIGN_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/DBNAME

# Statement timeout in milliseconds (Postgres). Default 15000. 0 disables.
FRONT_DESIGN_POSTGRES_STATEMENT_TIMEOUT_MS=15000

# Pool sizes are accepted by Settings; PostgresStore currently uses a single connection.

# =============================================================================
# Embeddings
# =============================================================================

# none (default) | openai | fastembed
# hashing is NOT valid (never worked).
FRONT_DESIGN_EMBEDDING_PROVIDER=none

# Model id; provider default when unset
# FRONT_DESIGN_EMBEDDING_MODEL=

# Optional dimension override. Must be supported by the model; unknown models
# without an explicit dimension error out (never silently assume 1536).
# Also used at Alembic migration time for embeddings.embedding vector(N).
# FRONT_DESIGN_EMBEDDING_DIMENSIONS=

# Required for openai. Use a placeholder locally — never commit real keys.
# FRONT_DESIGN_EMBEDDING_API_KEY=sk-REPLACE_ME

# Optional OpenAI-compatible base URL
# FRONT_DESIGN_EMBEDDING_BASE_URL=https://api.openai.com/v1

FRONT_DESIGN_EMBEDDING_BATCH_SIZE=32
FRONT_DESIGN_EMBEDDING_TIMEOUT=30
FRONT_DESIGN_EMBEDDING_MAX_RETRIES=3

# Bump to force re-embedding after chunking/normalization changes
FRONT_DESIGN_EMBEDDING_PIPELINE_VERSION=1

# openai: uv sync --extra embeddings
# fastembed: uv sync --group local

# =============================================================================
# Search
# =============================================================================

# auto | lexical | vector | hybrid
# auto → hybrid when backend+embeddings allow it, else lexical
FRONT_DESIGN_SEARCH_MODE=auto

FRONT_DESIGN_RRF_K=60
FRONT_DESIGN_RRF_LEXICAL_WEIGHT=1.0
FRONT_DESIGN_RRF_VECTOR_WEIGHT=1.0

# Per-branch candidate pool size before fusion
FRONT_DESIGN_SEARCH_CANDIDATES=50
