# Data directory for fixtures, cache, and local artifacts
# Default: ./data (relative to process cwd)
FRONT_DESIGN_DATA_DIR=

# SQLite database path (defaults to $FRONT_DESIGN_DATA_DIR/store/front_design.db)
FRONT_DESIGN_DB_PATH=

# Logging: DEBUG, INFO, WARNING, ERROR
FRONT_DESIGN_LOG_LEVEL=INFO

# HTTP timeout (seconds) for network ingest
FRONT_DESIGN_HTTP_TIMEOUT=30

# Network ingest off by default (local-first / offline fixtures)
# Set true only when you intentionally fetch remote registries
FRONT_DESIGN_ENABLE_NETWORK_INGEST=false

# Embedding provider: none | hashing
# Default none = BM25 lexical search only (no vector DB)
FRONT_DESIGN_EMBEDDING_PROVIDER=none
