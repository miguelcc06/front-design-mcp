      "type": "registry:ui",
      "title": "Meteors",
      "description": "A meteor shower effect.",
      "cssVars": {
        "theme": {
          "animate-meteor": "meteor 5s linear infinite"
        }
      },
      "css": {
        "@keyframes meteor": {
          "0%": {
            "transform": "rotate(var(--angle)) translateX(0)",
            "opacity": "1"
          },
          "70%": {
            "opacity": "1"
          },
          "100%": {
            "transform": "rotate(var(--angle)) translateX(-500px)",
            "opacity": "0"
          }
        }
      },
